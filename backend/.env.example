# Salin file ini menjadi .env lalu ganti SECRET_KEY dengan string acak.
# Cara membuat string acak:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang
TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./canteencare.db
FIREBASE_CREDENTIALS=firebase-service-account.json
TIMEZONE=Asia/Jakarta
UPLOAD_DIR=uploads
BCRYPT_ROUNDS=12
